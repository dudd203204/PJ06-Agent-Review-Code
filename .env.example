# ============================================================================
# LLM PROVIDER SELECTION
# ============================================================================
# Choose which provider to use: "openai" or "custom"
# Default: openai
LLM_PROVIDER=openai

# ============================================================================
# OPENAI CONFIGURATION (used when LLM_PROVIDER=openai)
# ============================================================================
# API key for OpenAI (required when using openai provider)
OPENAI_API_KEY=

# Model name (default: gpt-4o)
# Options: gpt-4o, gpt-4-turbo, gpt-4, gpt-3.5-turbo, etc.
OPENAI_MODEL=gpt-4o

# Temperature for model responses (default: 0)
# Range: 0.0 - 2.0, lower = more deterministic
OPENAI_TEMPERATURE=0

# ============================================================================
# CUSTOM LLM PROVIDER CONFIGURATION (used when LLM_PROVIDER=custom)
# For company's AI Farm / Azure-compatible API endpoint
# ============================================================================

# Base endpoint URL for custom provider
# Format: https://your-domain.com or similar
# Example: https://aoai-farm.bosch-temp.com
CUSTOM_LLM_ENDPOINT=https://aoai-farm.bosch-temp.com

# API Key (Bearer token authentication)
# Typically your subscription key / API key for the custom provider
# Required when using custom provider
CUSTOM_LLM_API_KEY=

# Deployment ID on the custom provider server
# Examples: gpt-4o-mini, gpt-5-nano-2025-08-07, etc.
# Ask your admin for the available deployment IDs
CUSTOM_LLM_DEPLOYMENT_ID=gpt-4o-mini

# API Version (Azure OpenAI compatible format)
# Examples: 2025-04-01-preview, 2024-12-01-preview, etc.
# Ask your admin for the correct API version
CUSTOM_LLM_API_VERSION=2025-04-01-preview

# Optional: Subscription ID for tracking/auditing
# Not required for authentication, only for internal tracking
CUSTOM_LLM_SUBSCRIPTION_ID=

# Temperature for custom provider responses (default: 0)
CUSTOM_LLM_TEMPERATURE=0

# ============================================================================
# HOW TO SWITCH BETWEEN PROVIDERS
# ============================================================================
# Option 1: Use OpenAI (cloud-based)
#   - Set LLM_PROVIDER=openai
#   - Set OPENAI_API_KEY to your OpenAI API key
#   - OPENAI_MODEL can be any OpenAI model
#   - No need to set CUSTOM_LLM_* variables
#
# Option 2: Use Custom Provider (company AI Farm)
#   - Set LLM_PROVIDER=custom
#   - Set all CUSTOM_LLM_* variables with your company credentials
#   - Get CUSTOM_LLM_ENDPOINT, API_KEY, DEPLOYMENT_ID, API_VERSION from admin
#   - No need to set OPENAI_* variables (they'll be ignored)
#

# ============================================================================
# OPTIONAL SETTINGS
# ============================================================================
# Hyperparameters configuration file path
HYPERPARAMS_PATH=config/hyperparams.json
