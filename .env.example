# OpenAI Configuration (default)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=0

# Custom LLM Provider Configuration (AI Farm - Azure-compatible API)
# Set LLM_PROVIDER to "custom" to use custom provider instead of OpenAI
LLM_PROVIDER=openai

# AI Farm Custom LLM Details (Azure OpenAI API format)
# Example: https://aoai-farm.bosch-temp.com
CUSTOM_LLM_ENDPOINT=https://aoai-farm.bosch-temp.com

# Bearer token for authentication (NOT subscription key)
# Example: YOUR_MODEL_FARM_SUBSCRIPTION_KEY_HERE
CUSTOM_LLM_API_KEY=

# Deployment ID on AI Farm server
# Example: gpt-5-nano-2025-08-07
CUSTOM_LLM_DEPLOYMENT_ID=gpt-5-nano-2025-08-07

# API version (Azure OpenAI format)
# Example: 2025-04-01-preview
CUSTOM_LLM_API_VERSION=2025-04-01-preview

# Optional: Subscription ID for tracking (not used in authentication)
CUSTOM_LLM_SUBSCRIPTION_ID=

# Temperature for model responses
CUSTOM_LLM_TEMPERATURE=0
